[Unit]
Description=DocDB Database
Documentation=https://hanzo.ai/docdb
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/bin/docdb
Restart=on-failure

# Configure the DocDB service with `systemctl edit docdb`.
# For more configuration options check `docdb --help`.

Environment="DOCDB_POSTGRESQL_URL=postgres://127.0.0.1:5432/postgres"

[Install]
WantedBy=multi-user.target
